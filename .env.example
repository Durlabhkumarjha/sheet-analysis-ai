# Copy this file to `.env` and fill in the values, then run `npm run build`.
# .env is gitignored — never commit real values.

# The Cloudflare Worker that proxies AI requests and meters credits.
# Defaults to the production worker if omitted.
VITE_AI_WORKER_URL=https://sheet-ai-proxy.sheetanalysisai.workers.dev

# --- Google Sheets import (optional) ---
# Leave both blank to hide the "Import from Google Sheets" button entirely.
#
# Set up at https://console.cloud.google.com :
#   1. Create a project.
#   2. APIs & Services > Library > enable "Google Picker API" and "Google Drive API".
#   3. APIs & Services > OAuth consent screen > External > add your email as a test user.
#      Scope needed: .../auth/drive.file  (non-sensitive — no Google verification required)
#   4. Credentials > Create Credentials > OAuth client ID > Web application.
#      Authorised JavaScript origins: https://sheet-analysis-ai.pages.dev
#                                     http://localhost:5173   (for local testing)
#      Copy the Client ID below.
#   5. Credentials > Create Credentials > API key. Copy it below.
#      (Recommended: restrict the key to your domain and to the Picker API.)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
